{
  "name": "spice-doctor",
  "version": "0.1.0",
  "description": "SPICE kernel manifest, coverage, and reproducibility workbench for planetary geometry workflows.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asystemoffields/spice-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/asystemoffields/spice-doctor/issues"
  },
  "homepage": "https://github.com/asystemoffields/spice-doctor#readme",
  "keywords": [
    "spice",
    "naif",
    "planetary-science",
    "kernels",
    "spiceypy",
    "nasa",
    "geometry"
  ],
  "main": "./src/index.js",
  "bin": {
    "spice-doctor": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "index.html",
    "src",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "requirements-spice.txt"
  ],
  "scripts": {
    "dev": "node scripts/serve.js",
    "build": "node scripts/build-site.js",
    "test": "node --test tests/*.test.js",
    "cli": "node src/cli.js",
    "export:catalog": "node scripts/export-catalog.js",
    "audit:spk": "python scripts/verify-spk-coverage.py",
    "smoke:spice": "python scripts/smoke-spice-geometry.py"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {}
}
